<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<WindowsPerformanceRecorder Team="HOBL" Company="Microsoft Corporation" Copyright="Microsoft Corporation" Version="1.0">
  <Profiles>
    <SystemCollector Id="SystemCollector_General" Name="NT Kernel Logger">
      <BufferSize Value="512"/>
      <Buffers Value="80"/>
    </SystemCollector>

    <EventCollector Id="EventCollector_UtcPerf" Name="UTC Perf Collector">
      <BufferSize Value="512"/>
      <Buffers Value="80"/>
    </EventCollector>

    <EventCollector Id="EventCollector_Office" Name="MSO Event Collector">
      <BufferSize Value="1024"/>
      <Buffers Value="16"/>
    </EventCollector>

    <SystemProvider Id="SystemProvider_General">
      <Keywords>
        <Keyword Value="CpuConfig"/>
      </Keywords>
    </SystemProvider>

    <EventProvider Id="EventProvider_PerfTrack" Name="PerfTrack" NonPagedMemory="true" Level="4"/>
    <EventProvider Id="EventProvider_UTC" Name="UTC" NonPagedMemory="true" Level="4"/>
    <EventProvider Id="EventProvider_InputInject" Name="150A3791-7792-452D-858C-15D647ECB48F"/>
    <!-- This narrow Shell-Core keyword enables events 18583/18584 used by PT_210. -->
    <EventProvider Id="EventProvider_Microsoft-Windows-Shell-Core" Name="30336ed4-e327-447c-9de0-51b652c86108" NonPagedMemory="true" Level="5">
      <Keywords>
        <Keyword Value="0x1000000000000"/>
      </Keywords>
    </EventProvider>

    <EventProvider Id="EventProvider_Office-CodeMarkers" Name="8736922D-E8B2-47eb-8564-23E77E728CF3" Stack="true">
      <Keywords Operation="Add">
        <Keyword Value="4"/>
      </Keywords>
    </EventProvider>
    <EventProvider Id="EventProvider_Office-Measurements" Name="a380209f-f500-586f-d5aa-1f15e23cefa5" Level="4" Stack="true"/>
    <EventProvider Id="EventProvider_Office-SessionId" Name="e6aec961-a5e0-5560-a860-15edd6b70f6c"/>
    <EventProvider Id="EventProvider_Office-CorrelationMetadata" Name="fc15139c-ddf2-481f-9a9b-365919cb8ae5"/>
    <EventProvider Id="EventProvider_Office-TelemetryEngine" Name="d1318fe0-16b7-4f5b-b5f9-ba3cd54cd9cc"/>
    <EventProvider Id="EventProvider_Office-Common" Name="8A3A9FD4-21D3-470B-B1D6-838B9FC8637B" Level="4" Stack="true"/>
    <EventProvider Id="EventProvider_Office-Excel" Name="6FD91573-4ABC-43A5-84EE-ACB8DC42888F" Level="4" Stack="true"/>
    <EventProvider Id="EventProvider_Office-PowerPoint" Name="71B8AC9B-04B7-4216-82C0-DD54FEE06D2C" Level="4" Stack="true"/>
    <EventProvider Id="EventProvider_Office-Extensibility" Name="1972DB93-8AB1-47A6-8FF5-F37744FDB721" Level="4" Stack="true"/>
    <EventProvider Id="EventProvider_AppLifeCycle-UI" Name="ee97cdc4-b095-5c70-6e37-a541eb74c2b5"/>
    <EventProvider Id="EventProvider_Helium-C2RX" Name="5526aed1-f6e5-5896-cbf0-27d9f59b6be7"/>
    <EventProvider Id="EventProvider_KernelProcess" Name="2839ff94-8f12-4e1b-82e3-af7af77a450f" NonPagedMemory="true"/>
    <EventProvider Id="EventProvider_Windows-Kernel-Process" Name="22fb2cd6-0e7b-422b-a0c7-2fad1fd0e716" NonPagedMemory="true">
      <Keywords>
        <Keyword Value="0x0010"/>
        <Keyword Value="0x0200"/>
      </Keywords>
    </EventProvider>

    <Profile Id="UtcCodeMarkers.Verbose.Memory" LoggingMode="Memory" Name="UtcCodeMarkers"
             Description="UTC performance capture with Office Code Markers, HVAs, and light logging"
             DetailLevel="Verbose">
      <ProblemCategories>
        <ProblemCategory Value="First Level Triage"/>
      </ProblemCategories>
      <Collectors>
        <SystemCollectorId Value="SystemCollector_General">
          <SystemProviderId Value="SystemProvider_General"/>
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_UtcPerf">
          <EventProviders>
            <EventProviderId Value="EventProvider_PerfTrack"/>
            <EventProviderId Value="EventProvider_UTC"/>
            <EventProviderId Value="EventProvider_InputInject"/>
            <EventProviderId Value="EventProvider_Microsoft-Windows-Shell-Core"/>
          </EventProviders>
        </EventCollectorId>
        <EventCollectorId Value="EventCollector_Office">
          <EventProviders>
            <EventProviderId Value="EventProvider_Office-CodeMarkers"/>
            <EventProviderId Value="EventProvider_Office-Measurements"/>
            <EventProviderId Value="EventProvider_Office-SessionId"/>
            <EventProviderId Value="EventProvider_Office-CorrelationMetadata"/>
            <EventProviderId Value="EventProvider_Office-TelemetryEngine"/>
            <EventProviderId Value="EventProvider_Office-Common"/>
            <EventProviderId Value="EventProvider_Office-Excel"/>
            <EventProviderId Value="EventProvider_Office-PowerPoint"/>
            <EventProviderId Value="EventProvider_Office-Extensibility"/>
            <EventProviderId Value="EventProvider_AppLifeCycle-UI"/>
            <EventProviderId Value="EventProvider_Helium-C2RX"/>
            <EventProviderId Value="EventProvider_KernelProcess"/>
            <EventProviderId Value="EventProvider_Windows-Kernel-Process"/>
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
    <Profile Base="UtcCodeMarkers.Verbose.Memory" Id="UtcCodeMarkers.Verbose.File"
             LoggingMode="File" Name="UtcCodeMarkers"
             Description="UTC performance capture with Office Code Markers, HVAs, and light logging"
             DetailLevel="Verbose"/>
  </Profiles>

  <TraceMergeProperties>
    <TraceMergeProperty Id="TraceMerge_Default" Name="TraceMerge_Default">
      <DeletePreMergedTraceFiles Value="true"/>
      <FileCompression Value="true"/>
      <CustomEvents Operation="Add">
        <CustomEvent Value="ImageId"/>
        <CustomEvent Value="BuildInfo"/>
        <CustomEvent Value="VolumeMapping"/>
        <CustomEvent Value="EventMetadata"/>
        <CustomEvent Value="PerfTrackMetadata"/>
        <CustomEvent Value="WinSAT"/>
        <CustomEvent Value="NetworkInterface"/>
      </CustomEvents>
    </TraceMergeProperty>
  </TraceMergeProperties>
</WindowsPerformanceRecorder>
