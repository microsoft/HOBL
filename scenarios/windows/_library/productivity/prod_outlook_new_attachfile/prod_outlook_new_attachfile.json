        "id": "PONAFT01",
        "text": "\ue00anafb",
        "type": "Type",
        "typing_delay": "400"
    },
    {
        "children": [],
        "delay": "3",
        "description": "",
        "enabled": true,
        "id": "1VHP12W",
        "type": "Delay"
    },
    {
        "children": [
            {
                "children": [],
                "delay": "8",
                "description": "Enter the OneDrive file path and attach the file (Enter)",
                "enabled": true,
                "id": "PONAFT03",
                "text": "[userprofile]\\onedrive\\[file_path]\ue007",
                "type": "Type",
                "typing_delay": "[typing_delay]"
            }
        ],
        "description": "Use the OneDrive attachment path",
        "enabled": true,
        "eval_method": "==",
        "id": "PONAFT02",
        "left_term": "[file_source]",
        "right_term": "OneDrive",
        "type": "If"
    },
    {
        "children": [
            {
                "children": [],
                "delay": "8",
                "description": "Enter the local file path and attach the file (Enter)",
                "enabled": true,
                "id": "PONAFT04",
                "text": "[userprofile]\\[file_path]\ue007",
                "type": "Type",
                "typing_delay": "[typing_delay]"
            }
        ],
        "description": "Use the local attachment path",
        "enabled": true,
        "id": "PONAFE01",
        "type": "Else"
